{
  "functions": {
    "api/*.py": {
      "includeFiles": "{templates/**,static/**,database.json,data.csv,DYPTC.csv,DAY2.csv}"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py?__path__=/api/$1"
    },
    {
      "src": "/api",
      "dest": "/api/index.py?__path__=/"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py?__path__=/$1"
    }
  ]
}

